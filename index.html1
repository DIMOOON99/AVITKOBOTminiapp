<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Выгодные объявления</title>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<style>
:root {
  color-scheme: light dark;
  --bg: var(--tg-theme-bg-color, #ffffff);
  --text: var(--tg-theme-text-color, #1c1c1e);
  --hint: var(--tg-theme-hint-color, #8e8e93);
  --link: var(--tg-theme-link-color, #2481cc);
  --btn: var(--tg-theme-button-color, #2481cc);
  --btn-text: var(--tg-theme-button-text-color, #ffffff);
  --sec: var(--tg-theme-secondary-bg-color, #f2f2f7);
  --line: rgba(128, 128, 128, .28);
  --danger: #e5484d;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: var(--tg-theme-bg-color, #17212b);
    --text: var(--tg-theme-text-color, #f5f5f5);
    --hint: var(--tg-theme-hint-color, #8d98a5);
    --sec: var(--tg-theme-secondary-bg-color, #232e3c);
  }
}
* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
html, body { margin: 0; background: var(--bg); color: var(--text); }
body {
  font: 16px/1.35 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  padding-bottom: calc(28px + env(safe-area-inset-bottom, 0px));
}
.hidden { display: none !important; }

.tabs {
  position: sticky; top: 0; z-index: 5; display: flex; gap: 4px;
  padding: 8px 12px; background: var(--bg); border-bottom: 1px solid var(--line);
}
.tab {
  flex: 1; border: 0; border-radius: 10px; padding: 9px 6px; font: inherit; font-size: 15px;
  background: transparent; color: var(--hint); cursor: pointer;
}
.tab.active { background: var(--sec); color: var(--text); font-weight: 600; }
.badge {
  display: inline-block; min-width: 18px; padding: 0 5px; border-radius: 9px;
  background: var(--btn); color: var(--btn-text); font-size: 12px; line-height: 18px;
}

main { padding: 6px 14px 0; }
label { display: block; margin: 14px 0 6px; font-size: 14px; color: var(--hint); }
label.check { display: flex; align-items: center; gap: 8px; color: var(--text); font-size: 15px; }
input[type=text], input[type=number], select {
  width: 100%; padding: 11px 12px; border: 1px solid var(--line); border-radius: 10px;
  background: var(--sec); color: var(--text); font: inherit; appearance: none; -webkit-appearance: none;
}
select {
  background-image: linear-gradient(45deg, transparent 50%, var(--hint) 50%),
                    linear-gradient(135deg, var(--hint) 50%, transparent 50%);
  background-position: calc(100% - 18px) 50%, calc(100% - 13px) 50%;
  background-size: 5px 5px, 5px 5px; background-repeat: no-repeat; padding-right: 32px;
}
input:focus, select:focus { outline: 2px solid var(--btn); outline-offset: 0; }
input[type=range] { width: 100%; accent-color: var(--btn); margin: 6px 0 2px; }
input[type=checkbox] { width: 20px; height: 20px; accent-color: var(--btn); }
.row { display: flex; gap: 10px; }
.row > * { flex: 1; min-width: 0; }
.row.add { align-items: stretch; margin-top: 8px; }
.row.add input { flex: 3; }
.row.add button { flex: 1.3; }

.card { margin-top: 16px; padding: 4px 14px 14px; border-radius: 14px; background: var(--sec); }
.card input[type=text], .card select { background: var(--bg); }
.card label:first-child { margin-top: 12px; }
details.card { padding: 0 14px; }
details.card > summary { padding: 14px 0; font-weight: 600; cursor: pointer; list-style-position: inside; }
details.card[open] > summary { border-bottom: 1px solid var(--line); margin-bottom: 4px; }
details.card[open] { padding-bottom: 14px; }

.seg { display: flex; gap: 6px; }
.seg button {
  flex: 1; padding: 9px 0; border: 1px solid var(--line); border-radius: 10px; font: inherit;
  background: var(--bg); color: var(--text); cursor: pointer;
}
.seg button.on { background: var(--btn); color: var(--btn-text); border-color: var(--btn); font-weight: 600; }

.chips { display: flex; flex-wrap: wrap; gap: 6px; min-height: 8px; }
.chip {
  display: inline-flex; align-items: center; gap: 6px; padding: 6px 6px 6px 12px;
  border-radius: 16px; background: var(--bg); border: 1px solid var(--line); font-size: 15px;
}
.chip button {
  border: 0; width: 22px; height: 22px; border-radius: 11px; padding: 0; line-height: 22px;
  background: var(--sec); color: var(--hint); font-size: 14px; cursor: pointer;
}

.btn {
  display: block; width: 100%; margin-top: 16px; padding: 13px; border: 0; border-radius: 12px;
  background: var(--btn); color: var(--btn-text); font: inherit; font-weight: 600; cursor: pointer;
}
.btn.secondary { background: var(--sec); color: var(--text); font-weight: 500; }
.btn.small { margin-top: 0; padding: 0 8px; font-size: 15px; }
.btn.danger { background: transparent; color: var(--danger); font-weight: 500; }
.card .btn.secondary { background: var(--bg); border: 1px solid var(--line); }
.hint { color: var(--hint); font-size: 13px; margin: 10px 0 0; }

h3 { margin: 22px 0 8px; font-size: 14px; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; color: var(--hint); }
.item {
  display: flex; align-items: center; gap: 10px; padding: 12px 14px; margin-bottom: 8px;
  border-radius: 12px; background: var(--sec);
}
.item .main { flex: 1; min-width: 0; cursor: pointer; }
.item .title { font-weight: 600; overflow-wrap: anywhere; }
.item .meta { color: var(--hint); font-size: 13px; margin-top: 2px; overflow-wrap: anywhere; }
.item .x {
  border: 0; background: transparent; color: var(--hint); font-size: 20px; padding: 4px 8px; cursor: pointer;
}
.item .x.danger { color: var(--danger); font-size: 14px; }
.empty { color: var(--hint); text-align: center; padding: 18px 8px; }

.toast {
  position: fixed; left: 50%; bottom: calc(80px + env(safe-area-inset-bottom, 0px));
  transform: translateX(-50%); max-width: 86%; padding: 10px 16px; border-radius: 12px;
  background: rgba(30, 30, 30, .92); color: #fff; font-size: 14px; text-align: center;
  opacity: 0; pointer-events: none; transition: opacity .2s; z-index: 10;
}
.toast.show { opacity: 1; }
</style>
</head>
<body>

<div class="tabs">
  <button id="tab-search" class="tab active" data-tab="search">Поиск</button>
  <button id="tab-saved" class="tab" data-tab="saved">Сохранённое</button>
  <button id="tab-watch" class="tab" data-tab="watch">Слежение <span id="watchCount" class="badge hidden"></span></button>
</div>

<main>
  <!-- ===================== Поиск ===================== -->
  <section id="panel-search">
    <label for="q">Что ищем</label>
    <input id="q" type="text" maxlength="100" placeholder="iphone 13 128gb" autocomplete="off">

    <div class="row">
      <div><label for="pmin">Цена от, ₽</label><input id="pmin" type="number" inputmode="numeric" min="0" placeholder="0"></div>
      <div><label for="pmax">Цена до, ₽</label><input id="pmax" type="number" inputmode="numeric" min="0" placeholder="любая"></div>
    </div>

    <div class="row">
      <div><label for="city">Город</label><select id="city"></select></div>
      <div>
        <label for="seller">Продавец</label>
        <select id="seller">
          <option value="частный">Частные</option>
          <option value="компания">Компании</option>
          <option value="все">Все</option>
        </select>
      </div>
    </div>

    <label for="sort">Сортировка выдачи</label>
    <select id="sort">
      <option value="">По умолчанию</option>
      <option value="дешевле">Сначала дешевле</option>
      <option value="дороже">Сначала дороже</option>
      <option value="новее">Сначала новые</option>
    </select>

    <label for="age">Опубликовано</label>
    <select id="age">
      <option value="">Любое время</option>
      <option value="1">За последний час</option>
      <option value="6">За 6 часов</option>
      <option value="24">За сутки</option>
      <option value="72">За 3 дня</option>
      <option value="168">За неделю</option>
    </select>
    <p class="hint">Если выбрано время, выдача автоматически сортируется по дате публикации.</p>

    <div class="card">
      <label for="disc">Выгодно: дешевле медианы на ≥ <b id="discVal">20</b>%</label>
      <input id="disc" type="range" min="5" max="60" step="5" value="20">
      <label>Сколько показывать</label>
      <div class="seg" id="topSeg"></div>
    </div>

    <div class="card">
      <label>Исключить слова (в названии или описании)</label>
      <div id="chips" class="chips"></div>
      <div class="row add">
        <input id="stopInput" type="text" maxlength="30" placeholder="например: обмен" autocomplete="off">
        <button id="stopAdd" class="btn small secondary" type="button">Добавить</button>
      </div>
    </div>

    <button id="favBtn" class="btn secondary" type="button">⭐ В избранное</button>

    <details class="card" id="watchBox">
      <summary>👀 Следить за этим запросом</summary>
      <p class="hint">Бот сам проверит выдачу и напишет только о новых выгодных объявлениях.</p>
      <label for="interval">Как часто проверять</label>
      <select id="interval">
        <option value="30">Каждые 30 минут</option>
        <option value="60" selected>Каждый час</option>
        <option value="180">Каждые 3 часа</option>
      </select>
      <label class="check"><input type="checkbox" id="quietOn"> Тихие часы (без уведомлений)</label>
      <div class="row hidden" id="quietRow">
        <div><label for="qf">С</label><select id="qf"></select></div>
        <div><label for="qt">До</label><select id="qt"></select></div>
      </div>
      <button id="watchBtn" class="btn" type="button">Начать слежение</button>
      <p class="hint">Время считается по часам компьютера, на котором запущен бот.</p>
    </details>

    <button id="fallbackBtn" class="btn hidden" type="button">🔎 Найти выгодные</button>
  </section>

  <!-- ===================== Сохранённое ===================== -->
  <section id="panel-saved" class="hidden">
    <h3>Избранное</h3>
    <div id="favList"></div>
    <h3>История</h3>
    <div id="histList"></div>
  </section>

  <!-- ===================== Слежение ===================== -->
  <section id="panel-watch" class="hidden">
    <h3>Сейчас отслеживается</h3>
    <div id="watchList"></div>
    <p class="hint">После удаления приложение закроется, а бот ответит в чате. Свежий список слежений
      всегда открывается кнопкой «Открыть поиск» у поля ввода.</p>
  </section>
</main>

<div id="toast" class="toast" role="status"></div>

<script>
(function () {
  'use strict';

  var tg = window.Telegram && window.Telegram.WebApp;
  // Вне Telegram платформа равна 'unknown'. initData для проверки не годится: при запуске
  // кнопкой у поля ввода Telegram может его не передавать.
  var inTG = !!(tg && tg.platform && tg.platform !== 'unknown');
  if (tg) { try { tg.ready(); tg.expand(); } catch (e) {} }

  var CITIES = ['россия', 'москва', 'санкт-петербург', 'казань', 'екатеринбург', 'новосибирск',
                'нижний-новгород', 'краснодар', 'самара', 'уфа'];
  var DEFAULTS = { discount: 20, top: 10, stop: ['трейд-ин'] };
  var MAX_FAVS = 12, MAX_HIST = 10, MAX_STOP = 20;

  var state = { favs: [], hist: [], top: DEFAULTS.top, stop: DEFAULTS.stop.slice(), watches: [] };

  function $(id) { return document.getElementById(id); }
  function pad(n) { return (n < 10 ? '0' : '') + n; }
  function cap(s) { return s.charAt(0).toUpperCase() + s.slice(1); }
  function mk(tag, cls, text) {
    var e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text !== undefined) e.textContent = text;
    return e;
  }

  /* ---------- уведомление ---------- */
  var toastTimer;
  function toast(msg) {
    var t = $('toast');
    t.textContent = msg;
    t.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function () { t.classList.remove('show'); }, 2200);
  }

  /* ---------- хранилище: облако Telegram, а вне Telegram — localStorage ---------- */
  function cloudOK() {
    return !!(inTG && tg.CloudStorage && tg.isVersionAtLeast && tg.isVersionAtLeast('6.9'));
  }
  function localGet(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
  function storeGet(key) {
    return new Promise(function (resolve) {
      var done = false;
      function fin(v) { if (!done) { done = true; resolve(v); } }
      setTimeout(function () { fin(localGet(key)); }, 1500);
      if (!cloudOK()) { fin(localGet(key)); return; }
      try {
        tg.CloudStorage.getItem(key, function (err, val) { fin(!err && val ? val : localGet(key)); });
      } catch (e) { fin(localGet(key)); }
    });
  }
  function storeSet(key, val) {
    return new Promise(function (resolve) {
      var done = false;
      function fin() { if (!done) { done = true; resolve(); } }
      setTimeout(fin, 1500);
      try { localStorage.setItem(key, val); } catch (e) {}
      if (!cloudOK()) { fin(); return; }
      try { tg.CloudStorage.setItem(key, val, fin); } catch (e) { fin(); }
    });
  }
  function parseJSON(s, fallback) {
    try { var v = JSON.parse(s); return v === null || v === undefined ? fallback : v; }
    catch (e) { return fallback; }
  }
  // Облако Telegram хранит до 4096 символов на ключ: старые записи отбрасываем.
  function pack(arr) {
    var a = arr.slice();
    while (a.length && JSON.stringify(a).length > 3800) a.pop();
    return JSON.stringify(a);
  }

  /* ---------- описание поиска ---------- */
  function sigOf(p) {
    return JSON.stringify([p.query.toLowerCase(), p.pmin, p.pmax, p.city, p.seller, p.sort, p.age || null, p.discount, p.top, p.stop]);
  }
  function metaOf(p) {
    var parts = [];
    if (p.city && p.city !== 'россия') parts.push(cap(p.city));
    if (p.pmin !== null || p.pmax !== null) parts.push((p.pmin === null ? '' : p.pmin) + '–' + (p.pmax === null ? '' : p.pmax) + ' ₽');
    parts.push({ 'частный': 'частные', 'компания': 'компании', 'все': 'все продавцы' }[p.seller] || p.seller);
    if (p.sort) parts.push('сорт.: ' + p.sort);
    if (p.age) parts.push('опубликовано ' + ({ 1: 'за час', 6: 'за 6 ч', 24: 'за сутки', 72: 'за 3 дня', 168: 'за неделю' }[p.age] || p.age + ' ч'));
    parts.push('выгода ≥' + p.discount + '%');
    parts.push('топ ' + p.top);
    if (p.stop.length) parts.push('без: ' + p.stop.join(', '));
    return parts.join(' · ');
  }

  /* ---------- форма ---------- */
  function readForm() {
    function num(id) { var v = $(id).value.trim(); return v === '' ? null : Number(v); }
    return {
      query: $('q').value.trim().replace(/\s+/g, ' '),
      pmin: num('pmin'),
      pmax: num('pmax'),
      city: $('city').value,
      seller: $('seller').value,
      sort: $('sort').value,
      age: $('age').value === '' ? null : Number($('age').value),
      discount: Number($('disc').value),
      top: state.top,
      stop: state.stop.slice()
    };
  }
  function fillForm(p) {
    $('q').value = p.query || '';
    $('pmin').value = p.pmin === null || p.pmin === undefined ? '' : p.pmin;
    $('pmax').value = p.pmax === null || p.pmax === undefined ? '' : p.pmax;
    $('city').value = p.city || 'россия';
    $('seller').value = p.seller || 'частный';
    $('sort').value = p.sort || '';
    $('age').value = p.age ? String(p.age) : '';
    $('disc').value = p.discount || DEFAULTS.discount;
    $('discVal').textContent = $('disc').value;
    state.top = p.top || DEFAULTS.top;
    state.stop = (p.stop || []).slice();
    renderTop();
    renderChips();
  }
  function applySettings(set) {
    $('disc').value = set.discount >= 5 && set.discount <= 60 ? set.discount : DEFAULTS.discount;
    $('discVal').textContent = $('disc').value;
    state.top = [5, 10, 15].indexOf(set.top) !== -1 ? set.top : DEFAULTS.top;
    state.stop = Array.isArray(set.stop) ? set.stop.slice(0, MAX_STOP) : DEFAULTS.stop.slice();
    renderTop();
    renderChips();
  }
  function validate(p) {
    if (!p.query) return 'Введите, что искать';
    if (p.pmin !== null && p.pmax !== null && p.pmin > p.pmax) return 'Цена «от» больше цены «до»';
    return '';
  }

  function renderTop() {
    var box = $('topSeg');
    box.textContent = '';
    [5, 10, 15].forEach(function (n) {
      var b = mk('button', n === state.top ? 'on' : '', String(n));
      b.type = 'button';
      b.addEventListener('click', function () { state.top = n; renderTop(); });
      box.appendChild(b);
    });
  }

  function renderChips() {
    var box = $('chips');
    box.textContent = '';
    state.stop.forEach(function (w, i) {
      var chip = mk('span', 'chip');
      chip.appendChild(mk('span', '', w));
      var x = mk('button', '', '×');
      x.type = 'button';
      x.setAttribute('aria-label', 'Убрать «' + w + '»');
      x.addEventListener('click', function () { state.stop.splice(i, 1); renderChips(); });
      chip.appendChild(x);
      box.appendChild(chip);
    });
  }
  function addStop() {
    var w = $('stopInput').value.trim().replace(/\s+/g, ' ').toLowerCase();
    if (!w) return;
    if (state.stop.indexOf(w) !== -1) { toast('Это слово уже в списке'); return; }
    if (state.stop.length >= MAX_STOP) { toast('Максимум ' + MAX_STOP + ' слов'); return; }
    state.stop.push(w);
    $('stopInput').value = '';
    renderChips();
  }

  /* ---------- сохранённое ---------- */
  function itemRow(p, onOpen, onDelete) {
    var row = mk('div', 'item');
    var main = mk('div', 'main');
    main.appendChild(mk('div', 'title', p.query));
    main.appendChild(mk('div', 'meta', metaOf(p)));
    main.addEventListener('click', onOpen);
    row.appendChild(main);
    if (onDelete) {
      var x = mk('button', 'x', '✕');
      x.type = 'button';
      x.setAttribute('aria-label', 'Удалить');
      x.addEventListener('click', onDelete);
      row.appendChild(x);
    }
    return row;
  }
  function renderSaved() {
    var fl = $('favList'), hl = $('histList');
    fl.textContent = ''; hl.textContent = '';
    if (!state.favs.length) fl.appendChild(mk('div', 'empty', 'Пока пусто. Нажмите «⭐ В избранное» на вкладке поиска.'));
    state.favs.forEach(function (p, i) {
      fl.appendChild(itemRow(p, function () { fillForm(p); showTab('search'); }, function () {
        state.favs.splice(i, 1);
        storeSet('fav', pack(state.favs));
        renderSaved();
      }));
    });
    if (!state.hist.length) hl.appendChild(mk('div', 'empty', 'История появится после первого поиска.'));
    state.hist.forEach(function (p) {
      hl.appendChild(itemRow(p, function () { fillForm(p); showTab('search'); }, null));
    });
  }

  function remember(list, p, max) {
    var s = sigOf(p);
    var out = [p].concat(list.filter(function (x) { return sigOf(x) !== s; }));
    return out.slice(0, max);
  }
  function addFavorite() {
    var p = readForm();
    var err = validate(p);
    if (err) { toast(err); return; }
    var s = sigOf(p);
    if (state.favs.some(function (x) { return sigOf(x) === s; })) { toast('Уже в избранном'); return; }
    if (state.favs.length >= MAX_FAVS) { toast('В избранном максимум ' + MAX_FAVS); return; }
    state.favs.unshift(p);
    storeSet('fav', pack(state.favs));
    renderSaved();
    toast('⭐ Добавлено в избранное');
  }

  /* ---------- слежение ---------- */
  function decodeState(s) {
    try {
      s = s.replace(/-/g, '+').replace(/_/g, '/');
      while (s.length % 4) s += '=';
      var bin = atob(s);
      var bytes = Uint8Array.from(bin, function (c) { return c.charCodeAt(0); });
      return JSON.parse(new TextDecoder().decode(bytes));
    } catch (e) { return null; }
  }
  function renderWatch() {
    var box = $('watchList');
    box.textContent = '';
    var n = state.watches.length;
    var badge = $('watchCount');
    badge.textContent = n;
    badge.classList.toggle('hidden', n === 0);
    if (!n) { box.appendChild(mk('div', 'empty', 'Слежений нет. На вкладке «Поиск» откройте «👀 Следить за этим запросом».')); return; }
    state.watches.forEach(function (w) {
      var row = mk('div', 'item');
      var main = mk('div', 'main');
      main.style.cursor = 'default';
      main.appendChild(mk('div', 'title', w.q));
      var meta = 'каждые ' + w.i + ' мин';
      if (w.qf !== null && w.qf !== undefined) meta += ' · тихие часы ' + pad(w.qf) + ':00–' + pad(w.qt) + ':00';
      main.appendChild(mk('div', 'meta', meta));
      row.appendChild(main);
      var del = mk('button', 'x danger', 'Удалить');
      del.type = 'button';
      del.addEventListener('click', function () { send({ action: 'watch_remove', id: w.id }); });
      row.appendChild(del);
      box.appendChild(row);
    });
  }

  /* ---------- отправка боту ---------- */
  function send(payload) {
    var data = JSON.stringify(payload);
    if (inTG) {
      tg.sendData(data);   // приложение закроется, бот ответит в чате
    } else {
      window.__lastPayload = payload;
      console.log('sendData:', data);
      toast('Тест вне Telegram: данные в консоли');
    }
  }
  function rememberSearch(p) {
    state.hist = remember(state.hist, p, MAX_HIST);
    var settings = { discount: p.discount, top: p.top, stop: p.stop };
    return Promise.all([
      storeSet('hist', pack(state.hist)),
      storeSet('settings', JSON.stringify(settings))
    ]);
  }
  function submit(action) {
    var p = readForm();
    var err = validate(p);
    if (err) { toast(err); if (!p.query) $('q').focus(); return; }
    var payload = Object.assign({ action: action }, p);
    if (action === 'watch_add') {
      payload.interval = Number($('interval').value);
      payload.quiet = $('quietOn').checked ? [Number($('qf').value), Number($('qt').value)] : null;
      if (payload.quiet && payload.quiet[0] === payload.quiet[1]) { toast('Начало и конец тихих часов совпадают'); return; }
    }
    rememberSearch(p).then(function () { send(payload); });
  }

  /* ---------- вкладки ---------- */
  function showTab(name) {
    ['search', 'saved', 'watch'].forEach(function (n) {
      $('tab-' + n).classList.toggle('active', n === name);
      $('panel-' + n).classList.toggle('hidden', n !== name);
    });
    if (inTG) {
      try { if (name === 'search') tg.MainButton.show(); else tg.MainButton.hide(); } catch (e) {}
    } else {
      $('fallbackBtn').classList.toggle('hidden', name !== 'search');
    }
    if (name === 'saved') renderSaved();
    window.scrollTo(0, 0);
  }

  /* ---------- запуск ---------- */
  function init() {
    // города и часы
    CITIES.forEach(function (c) {
      var o = mk('option', '', cap(c)); o.value = c; $('city').appendChild(o);
    });
    for (var h = 0; h < 24; h++) {
      ['qf', 'qt'].forEach(function (id) {
        var o = mk('option', '', pad(h) + ':00'); o.value = h; $(id).appendChild(o);
      });
    }
    $('qf').value = 23; $('qt').value = 8;

    // события
    document.querySelectorAll('.tab').forEach(function (b) {
      b.addEventListener('click', function () { showTab(b.getAttribute('data-tab')); });
    });
    $('disc').addEventListener('input', function () { $('discVal').textContent = $('disc').value; });
    $('stopAdd').addEventListener('click', addStop);
    $('stopInput').addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); addStop(); } });
    $('favBtn').addEventListener('click', addFavorite);
    $('quietOn').addEventListener('change', function () { $('quietRow').classList.toggle('hidden', !$('quietOn').checked); });
    $('watchBtn').addEventListener('click', function () { submit('watch_add'); });
    $('fallbackBtn').addEventListener('click', function () { submit('search'); });
    $('q').addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); $('q').blur(); } });

    if (inTG) {
      try {
        tg.MainButton.setText('🔎 Найти выгодные');
        tg.MainButton.onClick(function () { submit('search'); });
        tg.MainButton.show();
      } catch (e) {}
    } else {
      $('fallbackBtn').classList.remove('hidden');
    }

    // слежения из адреса (их добавляет бот)
    var s = new URLSearchParams(location.search).get('s');
    var st = s ? decodeState(s) : null;
    state.watches = (st && Array.isArray(st.w)) ? st.w : [];
    renderWatch();

    // значения по умолчанию, потом — сохранённые настройки
    fillForm({ discount: DEFAULTS.discount, top: DEFAULTS.top, stop: DEFAULTS.stop });
    Promise.all([storeGet('fav'), storeGet('hist'), storeGet('settings')]).then(function (r) {
      state.favs = parseJSON(r[0], []);
      state.hist = parseJSON(r[1], []);
      var set = parseJSON(r[2], null);
      if (set) applySettings(set);
      renderSaved();
    });
  }
  init();

  // для тестов вне Telegram
  window.__app = { decodeState: decodeState, sigOf: sigOf, pack: pack };
})();
</script>
</body>
</html>
